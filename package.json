    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx scripts/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.38.3",
    "jose": "^5.10.0",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.9.0",
    "nanoid": "^5.0.9",
    "next": "15.5.29",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/pdf-parse": "^1.1.4",
