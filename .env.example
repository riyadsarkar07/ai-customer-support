# ---------------------------------------------------------------------------
# SupportPilot environment configuration
# Copy to .env and fill in the values you need. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL 15+ with the pgvector extension available.
DATABASE_URL=postgres://saas:saas_dev_password@127.0.0.1:5432/saasdb

# Optional Redis (reserved for future multi-node scaling).
# REDIS_URL=redis://127.0.0.1:6379

# Signs session cookies and derives the AES key used to encrypt stored
# channel secrets. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret-at-least-16-chars

# ---------------------------------------------------------------------------
# AI provider (OpenAI-compatible). Embeddings are required for RAG.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Channels
# ---------------------------------------------------------------------------
# Telegram: set when registering the webhook.
TELEGRAM_WEBHOOK_SECRET=

# Meta (Messenger / Instagram)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Email channels (OAuth apps)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Billing - Bangladesh gateways
# ---------------------------------------------------------------------------
# SSLCOMMERZ
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# bKash (tokenized checkout)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Nagad
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_BASE_URL=https://sandbox-ssl.mynagad.com:10060/remote-payment-gateway-1.0

# ---------------------------------------------------------------------------
# File storage (knowledge uploads). Falls back to local UPLOAD_DIR when unset.
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
UPLOAD_DIR=./uploads

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Set to true only for load testing; disables API rate limiting.
RATE_LIMIT_DISABLED=false
# Background worker polling interval in milliseconds.
WORKER_POLL_MS=5000

# Seed script password for demo accounts (optional).
SEED_PASSWORD=SupportPilot123!
